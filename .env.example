PORT=3000

# SQLite (default — no extra configuration required)
DB_TYPE=sqlite
DB_DATABASE=database.sqlite

# PostgreSQL (uncomment to use with Docker)
# DB_HOST is the compose service name — inside the app container, localhost is the app itself
# DB_TYPE=postgres
# DB_HOST=postgres
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=ecommerce_challenge
